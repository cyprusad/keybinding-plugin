#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
fixture=$(mktemp -d)
trap 'rm -rf "$fixture"' EXIT
mkdir -p "$fixture/home/.config/hypr"
config="$fixture/home/.config/hypr/hyprland.lua"
printf 'require("default.hypr.omarchy")\n' > "$config"
hash=$(HOME="$fixture/home" "$root/scripts/bridge-control" inspect --config "$config" | jq -r .currentHash)
enabled=$(HOME="$fixture/home" "$root/scripts/bridge-control" enable --config "$config" --state-dir "$fixture/state" --expected-hash "$hash" --no-live-reload)
printf '%s\n' "$enabled" | jq -e '.ok == true and .changed == true and .validation == "skipped"' >/dev/null
grep -q 'Keybind Dojo managed bridge' "$config"
new_hash=$(printf '%s\n' "$enabled" | jq -r .newHash)
disabled=$(HOME="$fixture/home" "$root/scripts/bridge-control" disable --config "$config" --state-dir "$fixture/state" --expected-hash "$new_hash" --no-live-reload)
printf '%s\n' "$disabled" | jq -e '.ok == true and .changed == true' >/dev/null
test "$(cat "$config")" = 'require("default.hypr.omarchy")'
test -d "$fixture/state/backups"
