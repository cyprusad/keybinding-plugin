#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
store="$root/scripts/stats-store"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

state="$tmp/state"
stats="$state/stats.json"
recovery="$state/recovery"
payload='{"schemaVersion":1,"totalXp":0,"currentLevel":0,"streak":0,"lastQualifiedDay":null,"bindings":{},"dailyQuest":null}'

printf '%s' "$payload" | python3 "$store" write --path "$stats" --recovery-dir "$recovery" >/dev/null
[ "$(stat -c '%a' "$state")" = 700 ]
[ "$(stat -c '%a' "$stats")" = 600 ]
[ "$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["schemaVersion"])' "$stats")" = 1 ]

before=$(sha256sum "$stats" | cut -d ' ' -f 1)
if printf '%s' '{"schemaVersion":1' | python3 "$store" write --path "$stats" --recovery-dir "$recovery" >/dev/null 2>&1; then
  echo "invalid JSON unexpectedly succeeded" >&2
  exit 1
fi
[ "$before" = "$(sha256sum "$stats" | cut -d ' ' -f 1)" ]

mkdir "$tmp/blocked"
printf '%s' 'not a directory' > "$tmp/blocked/marker"
if printf '%s' "$payload" | python3 "$store" write --path "$tmp/blocked/marker/stats.json" --recovery-dir "$recovery" >/dev/null 2>&1; then
  echo "blocked atomic write unexpectedly succeeded" >&2
  exit 1
fi
[ "$(stat -c '%a' "$stats")" = 600 ]

printf '%s' "$payload" > "$stats"
python3 "$store" archive --path "$stats" --recovery-dir "$recovery" --keep 5 >/dev/null
[ ! -e "$stats" ]
[ "$(find "$recovery" -maxdepth 1 -type f -name 'stats-*.json' | wc -l)" = 1 ]
[ "$(stat -c '%a' "$(find "$recovery" -maxdepth 1 -type f -name 'stats-*.json' | head -n 1)")" = 600 ]

printf '%s' 'keep this file' > "$recovery/other.json"
i=1
while [ "$i" -le 6 ]; do
  printf '{"schemaVersion":1,"marker":%s}' "$i" > "$stats"
  python3 "$store" archive --path "$stats" --recovery-dir "$recovery" --keep 5 >/dev/null
  i=$((i + 1))
done
[ "$(find "$recovery" -maxdepth 1 -type f -name 'stats-*.json' | wc -l)" = 5 ]
[ -e "$recovery/other.json" ]

echo "stats storage fixtures passed"

env -u DISPLAY QT_QPA_PLATFORM=minimal QT_QPA_PLATFORMTHEME= \
  qmltestrunner -input "$root/tests/qml/tst_stats.qml" -o -,txt
